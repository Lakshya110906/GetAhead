{
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sweep-evaluations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/queue-alert",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/purge-old-logs",
      "schedule": "0 3 * * *"
    }
  ]
}
